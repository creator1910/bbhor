# $JOB — environment variables
# Copy to .env and fill in your keys before running

# Tavily API key — get one at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Google Gemini API key — get one at https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# Handelsregister.ai API key — optional, only needed for German company registry data
# Get 500 free credits at https://handelsregister.ai
# Leave blank to skip this data source gracefully
HANDELSREGISTER_API_KEY=
